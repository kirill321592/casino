# Copy to .env.local (git-ignored) and adjust.

# Origin of the game server (casino-back): REST under /auth and /slots, the
# roulette table on the /roulette Socket.IO namespace. No trailing slash.
# Optional for `npm run dev`, which falls back to http://localhost:3000.
# Required for `npm run build` — the build fails without it rather than ship a
# bundle that dials localhost.
VITE_GAME_SERVER_URL=http://localhost:3000
